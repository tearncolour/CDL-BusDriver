<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>

    <!--The file where mod information which is required for publishing mod on PDX mods are stored-->
    <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>

    <AssemblyName>CDLC.BusDriver</AssemblyName>
    <RootNamespace>CDLC.BusDriver</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- NativeGeometryFile reads the game's geometry into unmanaged memory and cuts it there -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The mods this one is compiled against and that the game loads beside it (never bundled): their standard build output. -->
    <DrivingModPath Condition="'$(DrivingModPath)' == ''">..\BetaTestDrivingMod\bin\$(Configuration)\net48</DrivingModPath>
    <AssetModRoot Condition="'$(AssetModRoot)' == ''">$(MSBuildThisFileDirectory)..\CDLAssetMod</AssetModRoot>
    <AssetModPath Condition="'$(AssetModPath)' == ''">$(AssetModRoot)\bin\$(Configuration)\net48</AssetModPath>
    <CDLCAssetBusIncludeLedHd>true</CDLCAssetBusIncludeLedHd>
    <!-- The work folders hold old builds, CDLC.dll among them: as project items they were candidates the reference resolution took
         before the HintPath (out\k18-core-camera-request\main-bin\CDLC.dll of 15 October), so DrivingModPath was not used. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);out\**;ModelSource\**</DefaultItemExcludes>
    <!-- Authoring (default true): the packer, the vehicle review session and the in-game probes/diagnostics (CDLC_AUTHORING). That is
         what pack_asset.sh and Tools/VehicleReview drive, so the default build keeps it. -p:Authoring=false builds the player DLL
         without them: it is a different binary, so it needs its own cold-start check before it replaces a build that was verified. -->
    <Authoring Condition="'$(Authoring)' == ''">true</Authoring>
    <DefineConstants Condition="'$(Authoring)' == 'true'">$(DefineConstants);CDLC_AUTHORING</DefineConstants>
    <CDLDevKitRoot Condition="'$(CDLDevKitRoot)' == ''">$(MSBuildThisFileDirectory)..\CDLDevKit</CDLDevKitRoot>
    <CDLDevKitPackagingIncludeExport Condition="'$(Authoring)' != 'true'">false</CDLDevKitPackagingIncludeExport>
  </PropertyGroup>

  <!--Imports must be after PropertyGroup block-->
  <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
  <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

  <ItemGroup Condition="'$(Authoring)' != 'true'">
    <Compile Remove="Systems/BusVehicleAssetSystem*.cs;Systems/BusPackageGlass.cs;Systems/BusPaletteImport.cs;Systems/BusReviewRequestState.cs" />
    <Compile Remove="Systems/*Probe.cs;Systems/*Diagnostic.cs;Systems/BusGlassBufferAudit.cs;Systems/BusProbeSkyReadback.cs" />
    <Compile Remove="Systems/BusVehicleInspectionLighting.cs;Systems/BusVehicleReviewSample.cs;Systems/BusVehicleMirrorUvCalibration.cs" />
    <Compile Remove="Systems/BusNativeEmissionControl.cs;Systems/BusNativeRendererControl.cs;Systems/BusVehicleMaterialDiagnostics.cs" />
  </ItemGroup>

  <Import Project="$(CDLDevKitRoot)\Packaging\CDLC.DevKit.Packaging.targets" />
  <Import Project="$(AssetModRoot)\Compatibility\CDLC.Asset.BusSources.targets" />

  <Target Name="CheckModPaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(DrivingModPath)\CDLC.dll')" Text="CDLC.dll not found in '$(DrivingModPath)'. Build CSL Driving Life Core first (or set DrivingModPath)." />
    <Error Condition="!Exists('$(AssetModPath)\CDLC.Asset.dll')" Text="CDLC.Asset.dll not found in '$(AssetModPath)'. Build CSL Driving Life : Assets first (or set AssetModPath)." />
  </Target>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
    <Compile Remove="out\**\*.cs" />
    <Compile Remove="ModelSource\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="lang\*.json" LogicalName="CDLC.BusDriver.lang.%(Filename).json" />
    <EmbeddedResource Include="Asset\CDLCBus12\Runtime\CDLCBus12.swb2.gz" LogicalName="CDLC.BusDriver.CDLCBus12.swb2.gz" />
    <EmbeddedResource Include="Asset\CDLCBus12\Runtime\CDLCBus12.swu1.gz" LogicalName="CDLC.BusDriver.CDLCBus12.swu1.gz" />
    <EmbeddedResource Include="Tools\CDLCBus12\vehicle.json" LogicalName="CDLC.BusDriver.CDLCBus12.vehicle.json" />
    <EmbeddedResource Include="Asset\CDLCBus12\Runtime\polymer-Detail.png" LogicalName="CDLC.BusDriver.Detail.polymer.png" />
    <EmbeddedResource Include="Asset\CDLCBus12\Runtime\leather-Detail.png" LogicalName="CDLC.BusDriver.Detail.leather.png" />
    <EmbeddedResource Include="Asset\CDLCBus12\Runtime\woven-Detail.png" LogicalName="CDLC.BusDriver.Detail.woven.png" />
    <EmbeddedResource Include="Asset\CDLCBus12\Runtime\brushed-Detail.png" LogicalName="CDLC.BusDriver.Detail.brushed.png" />
    <None Include="lang\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Audio\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Fonts\*.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- the licences of the font and reading data beside them (SIL OFL 1.1, Unicode License v3) -->
    <None Include="Fonts\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The mod's own bus as a vehicle asset: the package the game loads from the mod's folder (made by pack_asset.sh). The
         model files in Asset/CDLCBus12 are its source and stay in the repo. The authored buses are vehicle packs of their own
         (Packs/CDLC.Bus.<model>, Tools/VehiclePack/make_pack.py), never shipped in the mod. While pack_asset.sh makes the
         package again the file is not there (the mod is deployed without it first, so the game does not load the old one):
         the build must still go through then. -->
    <None Include="Asset\CDLCBus12.cok" Condition="Exists('Asset\CDLCBus12.cok')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Asset\CDLCBus12.cdlg.json" Condition="Exists('Asset\CDLCBus12.cok') And Exists('Asset\CDLCBus12.cdlg.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="CDLC.BusDriver.mjs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="CDLC.BusDriver.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Game">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Core">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Collections">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Mathematics">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Logging">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.IO.AssetDatabase">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.AssetPipeline">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.AssetPipeline.Native">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Localization">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.UI">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.UI.Binding">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Entities">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression">
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression.FileSystem">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.PSI.Common">
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Memory">
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <Private>false</Private>
    </Reference>
    <!-- The driving mod is a separate mod the player installs; it is never bundled. -->
    <Reference Include="CDLC.Asset">
      <HintPath>$(AssetModPath)\CDLC.Asset.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CDLC">
      <HintPath>$(DrivingModPath)\CDLC.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System">
      <Private>false</Private>
    </Reference>
    <Reference Update="System.Core">
      <Private>false</Private>
    </Reference>
    <Reference Update="System.Data">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--mod.json, the licence and the notices (the audio credits) are part of the folder the toolchain deploys and publishes-->
  <ItemGroup>
    <None Update="mod.json;LICENSE;NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
    <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
  </ItemGroup>
</Project>
