  "observed_features": {
    "front": [
      "宽黑色冠顶包覆车头上方，风挡与灯牌区连续黑色视觉面",
      "风挡下沿两端向上收，左右细长日行灯位于黑色下缘，形成折线眉带",
      "下部左右为多腔锐角LED灯组，不是6710的大圆灯",
      "白色下前围，中间申沃标及低位牌照；双雨刮"
    ],
    "rear": [
      "大黑色后窗，顶沿贯穿红色灯条/两端斜角",
      "窗下左右横向点阵红灯，接长竖折形红白尾灯",
      "大型白色机舱盖、中央申沃标、iEV10和SUNWIN标识；低位牌照",
      "没有6710三圆尾灯组"
    ],
    "sides_doors": [
      "右前门位于前轴之前，中门位于两轴之间，两门均双叶",
      "宽黑窗带，侧窗部分具有推拉上窗；后段窗数与10.5m车身对应",
      "车门侧后悬有驱动/设备舱竖百叶及检修门",
      "上海红或青双色细线沿窗带上下折返，白色主体；不是6710整车青绿"
    ],
    "mirrors": [
      "松江/官网版本采用门侧较长黑弯臂加白色大镜壳，独立椭圆补盲镜；司机侧白色小镜壳、较短支架",
      "青浦公告图选装传统黑杆矩形镜，属于不同镜组配置",
      "镜尺寸和位置尚未逐视角标定，不能沿用6710镜面坐标"
    ],
    "roof": [
      "实车高视点显示前中段空调/网罩设备及后段一系列低矮白色盖板，长车身屋顶布局不同于6710",
      "需要按实际松江图细化，不可把整顶做成一个高箱"
    ],
    "interior": [
      "公告图证实轮椅区及约束，侧向翻折座/隔挡、金属灰扶手、深灰地板及花纹软座",
      "实际照片可见浅灰仪表罩、方向盘、前门口扶手与司机隔挡",
      "完整座椅数量、逐座方向和驱动舱台阶尚未获得足够近景，不宣称精确还原"
    ]
  },
